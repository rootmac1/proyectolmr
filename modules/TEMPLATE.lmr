// Plantilla para un módulo comunitario de LMR.
// Renombra este archivo como NombreModulo.lmr y reemplaza los ejemplos.
// Documenta firmas y requisitos también en modules/manifest.json.

// API implementada enteramente en LMR:
func saludarModulo(string nombre): string
begin
    return "Hola, " + nombre
end


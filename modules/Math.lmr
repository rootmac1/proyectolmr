func squareRoot(float x): float
begin
    return sqrt(x)
end

func power(float base, float exponent): float
begin
    return pow(base, exponent)
end

func absoluteValue(float x): float
begin
    return abs(x)
end

// Trigonometry. Angles are expressed in radians.
func sine(float x): float
begin
    return sin(x)
end

func cosine(float x): float
begin
    return cos(x)
end

func tangent(float x): float
begin
    return tan(x)
end

func arcSine(float x): float
begin
    return asin(x)
end

func arcCosine(float x): float
begin
    return acos(x)
end

func arcTangent(float x): float
begin
    return atan(x)
end

func arcTangent2(float y, float x): float
begin
    return atan2(y, x)
end

func degreesToRadians(float degrees): float
begin
    return degrees * 3.141592653589793 / 180.0
end

func radiansToDegrees(float radians): float
begin
    return radians * 180.0 / 3.141592653589793
end

// Exponentials, logarithms, and rounding.
func exponential(float x): float
begin
    return exp(x)
end

func naturalLog(float x): float
begin
    return log(x)
end

func log10Value(float x): float
begin
    return log10(x)
end

func logarithm(float x, float base): float
begin
    return log(x) / log(base)
end

func floorValue(float x): float
begin
    return floor(x)
end

func ceiling(float x): float
begin
    return ceil(x)
end

func roundValue(float x): float
begin
    return round(x)
end

func realModulo(float x, float divisor): float
begin
    return fmod(x, divisor)
end

// Commonly used operations.
func hypotenuse(float x, float y): float
begin
    return sqrt(x * x + y * y)
end

func minimum(float a, float b): float
begin
    if a < b then begin
        return a
    end
    else begin
        return b
    end
end

func maximum(float a, float b): float
begin
    if a > b then begin
        return a
    end
    else begin
        return b
    end
end

func clamp(float x, float minimumValue, float maximumValue): float
begin
    if x < minimumValue then begin
        return minimumValue
    end
    else begin
        if x > maximumValue then begin
            return maximumValue
        end
        else begin
            return x
        end
    end
end

func interpolate(float start, float finish, float t): float
begin
    return start + (finish - start) * t
end

func sign(float x): int
begin
    if x < 0.0 then begin
        return -1
    end
    else begin
        if x > 0.0 then begin
            return 1
        end
        else begin
            return 0
        end
    end
end

func distance2D(float x1, float y1, float x2, float y2): float
begin
    float dx, dy
    dx = x2 - x1
    dy = y2 - y1
    return hypotenuse(dx, dy)
end

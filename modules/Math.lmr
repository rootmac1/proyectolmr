func raiz(float x): float
begin
    return sqrt(x)
end

func potencia(float base, float exp): float
begin
    return pow(base, exp)
end

func valorAbsoluto(float x): float
begin
    return abs(x)
end

// Trigonometría. Los ángulos se expresan en radianes.
func seno(float x): float
begin
    return sin(x)
end

func coseno(float x): float
begin
    return cos(x)
end

func tangente(float x): float
begin
    return tan(x)
end

func arcoSeno(float x): float
begin
    return asin(x)
end

func arcoCoseno(float x): float
begin
    return acos(x)
end

func arcoTangente(float x): float
begin
    return atan(x)
end

func arcoTangente2(float y, float x): float
begin
    return atan2(y, x)
end

func gradosARadianes(float grados): float
begin
    return grados * 3.141592653589793 / 180.0
end

func radianesAGrados(float radianes): float
begin
    return radianes * 180.0 / 3.141592653589793
end

// Exponenciales, logaritmos y redondeo.
func exponencial(float x): float
begin
    return exp(x)
end

func logNatural(float x): float
begin
    return log(x)
end

func logBase10(float x): float
begin
    return log10(x)
end

func logBase(float x, float base): float
begin
    return log(x) / log(base)
end

func piso(float x): float
begin
    return floor(x)
end

func techo(float x): float
begin
    return ceil(x)
end

func redondear(float x): float
begin
    return round(x)
end

func moduloReal(float x, float divisor): float
begin
    return fmod(x, divisor)
end

// Operaciones de uso frecuente.
func hipotenusa(float x, float y): float
begin
    return sqrt(x * x + y * y)
end

func valorMinimo(float a, float b): float
begin
    if a < b then begin
        return a
    end
    else begin
        return b
    end
end

func valorMaximo(float a, float b): float
begin
    if a > b then begin
        return a
    end
    else begin
        return b
    end
end

func limitar(float x, float minimo, float maximo): float
begin
    if x < minimo then begin
        return minimo
    end
    else begin
        if x > maximo then begin
            return maximo
        end
        else begin
            return x
        end
    end
end

func interpolar(float inicio, float fin, float t): float
begin
    return inicio + (fin - inicio) * t
end

func signo(float x): int
begin
    if x < 0.0 then begin
        return -1
    end
    else begin
        if x > 0.0 then begin
            return 1
        end
        else begin
            return 0
        end
    end
end

func distancia2D(float x1, float y1, float x2, float y2): float
begin
    float dx, dy
    dx = x2 - x1
    dy = y2 - y1
    return hipotenusa(dx, dy)
end

      "dependencies": ["Runtime de reporte que proporciona los argumentos"],
      "exports": [
        {"kind":"function","name":"reportStartDate","signature":"reportStartDate(): string"},
        {"kind":"function","name":"reportEndDate","signature":"reportEndDate(): string"},
        {"kind":"function","name":"reportStartTime","signature":"reportStartTime(): string"},
        {"kind":"function","name":"reportEndTime","signature":"reportEndTime(): string"},
        {"kind":"function","name":"reportCompound","signature":"reportCompound(): int"},
        {"kind":"function","name":"reportStakeOver","signature":"reportStakeOver(): float"},
        {"kind":"function","name":"reportStakeUnder","signature":"reportStakeUnder(): float"}
      ],
      "native_bindings": ["lmr_report_start_date","lmr_report_end_date","lmr_report_start_time","lmr_report_end_time","lmr_report_compound","lmr_report_stake_over","lmr_report_stake_under"]
    },
    {

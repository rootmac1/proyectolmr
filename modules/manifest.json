{
  "schema_version": "1.0.0",
  "language": "LMR",
  "description": "Catálogo descriptivo de módulos .lmr incluidos en este repositorio. No es un formato de carga de plugins.",
  "modules": [
    {
      "id": "Math",
      "file": "Math.lmr",
      "summary": "Math functions, trigonometry, angle conversions, and interpolation.",
      "category": "math",
      "status": "experimental",
      "platforms": ["all"],
      "dependencies": ["builtins: sqrt, pow, abs, sin, cos, tan, asin, acos, atan, atan2, exp, log, log10, floor, ceil, round, fmod"],
      "exports": [
        {"kind":"function","name":"squareRoot","signature":"squareRoot(float x): float"},
        {"kind":"function","name":"power","signature":"power(float base, float exponent): float"},
        {"kind":"function","name":"absoluteValue","signature":"absoluteValue(float x): float"},
        {"kind":"function","name":"sine","signature":"sine(float x): float","notes":"Angle in radians."},
        {"kind":"function","name":"cosine","signature":"cosine(float x): float","notes":"Angle in radians."},
        {"kind":"function","name":"tangent","signature":"tangent(float x): float","notes":"Angle in radians."},
        {"kind":"function","name":"arcSine","signature":"arcSine(float x): float"},
        {"kind":"function","name":"arcCosine","signature":"arcCosine(float x): float"},
        {"kind":"function","name":"arcTangent","signature":"arcTangent(float x): float"},
        {"kind":"function","name":"arcTangent2","signature":"arcTangent2(float y, float x): float"},
        {"kind":"function","name":"degreesToRadians","signature":"degreesToRadians(float degrees): float"},
        {"kind":"function","name":"radiansToDegrees","signature":"radiansToDegrees(float radians): float"},
        {"kind":"function","name":"exponential","signature":"exponential(float x): float"},
        {"kind":"function","name":"naturalLog","signature":"naturalLog(float x): float"},
        {"kind":"function","name":"log10Value","signature":"log10Value(float x): float"},
        {"kind":"function","name":"logarithm","signature":"logarithm(float x, float base): float"},
        {"kind":"function","name":"floorValue","signature":"floorValue(float x): float"},
        {"kind":"function","name":"ceiling","signature":"ceiling(float x): float"},
        {"kind":"function","name":"roundValue","signature":"roundValue(float x): float"},
        {"kind":"function","name":"realModulo","signature":"realModulo(float x, float divisor): float"},
        {"kind":"function","name":"hypotenuse","signature":"hypotenuse(float x, float y): float"},
        {"kind":"function","name":"minimum","signature":"minimum(float a, float b): float"},
        {"kind":"function","name":"maximum","signature":"maximum(float a, float b): float"},
        {"kind":"function","name":"clamp","signature":"clamp(float x, float minimumValue, float maximumValue): float"},
        {"kind":"function","name":"interpolate","signature":"interpolate(float start, float finish, float t): float"},
        {"kind":"function","name":"sign","signature":"sign(float x): int"},
        {"kind":"function","name":"distance2D","signature":"distance2D(float x1, float y1, float x2, float y2): float"}
      ],
      "native_bindings": []
    },
    {
      "id": "Matematicas",
      "file": "Matematicas.lmr",
      "summary": "Ejemplos básicos de duplicación y potencia entera.",
      "category": "math",
      "status": "experimental",
      "platforms": ["all"],
      "dependencies": [],
      "exports": [
        {"kind":"function","name":"duplicar","signature":"duplicar(int n): int"},
        {"kind":"function","name":"calcularPotencia","signature":"calcularPotencia(int base, int exp): int"}
      ],
      "native_bindings": []
    },

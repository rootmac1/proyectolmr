{
  "schema_version": "1.0.0",
  "language": "LMR",
  "description": "Catálogo descriptivo de módulos .lmr incluidos en este repositorio. No es un formato de carga de plugins.",
  "modules": [
    {
      "id": "Math",
      "file": "Math.lmr",
      "summary": "Funciones matemáticas, trigonometría, conversiones angulares e interpolación.",
      "category": "math",
      "status": "experimental",
      "platforms": ["all"],
      "dependencies": ["builtins: sqrt, pow, abs, sin, cos, tan, asin, acos, atan, atan2, exp, log, log10, floor, ceil, round, fmod"],
      "exports": [
        {"kind":"function","name":"raiz","signature":"raiz(float x): float"},
        {"kind":"function","name":"potencia","signature":"potencia(float base, float exp): float"},
        {"kind":"function","name":"valorAbsoluto","signature":"valorAbsoluto(float x): float"},
        {"kind":"function","name":"seno","signature":"seno(float x): float","notes":"Ángulo en radianes."},
        {"kind":"function","name":"coseno","signature":"coseno(float x): float","notes":"Ángulo en radianes."},
        {"kind":"function","name":"tangente","signature":"tangente(float x): float","notes":"Ángulo en radianes."},
        {"kind":"function","name":"arcoSeno","signature":"arcoSeno(float x): float"},
        {"kind":"function","name":"arcoCoseno","signature":"arcoCoseno(float x): float"},
        {"kind":"function","name":"arcoTangente","signature":"arcoTangente(float x): float"},
        {"kind":"function","name":"arcoTangente2","signature":"arcoTangente2(float y, float x): float"},
        {"kind":"function","name":"gradosARadianes","signature":"gradosARadianes(float grados): float"},
        {"kind":"function","name":"radianesAGrados","signature":"radianesAGrados(float radianes): float"},
        {"kind":"function","name":"exponencial","signature":"exponencial(float x): float"},
        {"kind":"function","name":"logNatural","signature":"logNatural(float x): float"},
        {"kind":"function","name":"logBase10","signature":"logBase10(float x): float"},
        {"kind":"function","name":"logBase","signature":"logBase(float x, float base): float"},
        {"kind":"function","name":"piso","signature":"piso(float x): float"},
        {"kind":"function","name":"techo","signature":"techo(float x): float"},
        {"kind":"function","name":"redondear","signature":"redondear(float x): float"},
        {"kind":"function","name":"moduloReal","signature":"moduloReal(float x, float divisor): float"},
        {"kind":"function","name":"hipotenusa","signature":"hipotenusa(float x, float y): float"},
        {"kind":"function","name":"valorMinimo","signature":"valorMinimo(float a, float b): float"},
        {"kind":"function","name":"valorMaximo","signature":"valorMaximo(float a, float b): float"},
        {"kind":"function","name":"limitar","signature":"limitar(float x, float minimo, float maximo): float"},
        {"kind":"function","name":"interpolar","signature":"interpolar(float inicio, float fin, float t): float"},
        {"kind":"function","name":"signo","signature":"signo(float x): int"},
        {"kind":"function","name":"distancia2D","signature":"distancia2D(float x1, float y1, float x2, float y2): float"}
      ],
      "native_bindings": []
    },
    {
      "id": "Matematicas",
      "file": "Matematicas.lmr",

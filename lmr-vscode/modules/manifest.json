    {
      "id": "Graphics",
      "file": "Graphics.lmr",
      "summary": "API de ventana y dibujo 2D con tabla, texto desplazable y consulta de teclas.",
      "category": "graphics",
      "status": "experimental",
      "platforms": ["windows"],
      "dependencies": ["Puente gráfico nativo src/trade_bridge.c", "Bibliotecas Win32 enlazadas por el compilador"],
      "exports": [
        {"kind":"function","name":"initWindow","signature":"initWindow(int w, int h, string t)"},
        {"kind":"function","name":"windowShouldClose","signature":"windowShouldClose(): bool"},
        {"kind":"function","name":"beginDrawing","signature":"beginDrawing()"},
        {"kind":"function","name":"clearBackground","signature":"clearBackground(int r, int g, int b)"},
        {"kind":"function","name":"drawRectangle","signature":"drawRectangle(int x, int y, int w, int h, int r, int g, int b)"},
        {"kind":"function","name":"drawText","signature":"drawText(string texto, int x, int y, int size, int r, int g, int b)"},
        {"kind":"function","name":"drawScrollableText","signature":"drawScrollableText(string texto, int x, int y, int w, int h, int size, int r, int g, int b)"},
        {"kind":"function","name":"drawReportTable","signature":"drawReportTable(string data, int x, int y, int w, int h, int size)"},
        {"kind":"function","name":"endDrawing","signature":"endDrawing()"},
        {"kind":"function","name":"closeWindow","signature":"closeWindow()"},
        {"kind":"function","name":"isKeyDown","signature":"isKeyDown(int key): bool"},
        {"kind":"function","name":"KEY_W","signature":"KEY_W(): int"},
        {"kind":"function","name":"KEY_S","signature":"KEY_S(): int"},
        {"kind":"function","name":"KEY_UP","signature":"KEY_UP(): int"},
        {"kind":"function","name":"KEY_DOWN","signature":"KEY_DOWN(): int"}
      ],
      "native_bindings": ["lmr_init_window","lmr_window_should_close","lmr_begin_drawing","lmr_clear_background","lmr_draw_rectangle","lmr_draw_text","lmr_end_drawing","lmr_close_window","lmr_is_key_down","lmr_draw_scrollable_text","lmr_draw_report_table"]
    },
    {
      "id": "SQLite",
      "file": "SQLite.lmr",
      "summary": "Conexión SQLite, ejecución SQL y cursor de lectura mediante puente nativo.",
      "category": "database",
      "status": "experimental",
      "platforms": ["windows"],
      "dependencies": ["Puente nativo SQLite en src/trade_bridge.c", "Windows: winsqlite3.dll del sistema o sqlite3.dll disponible en tiempo de ejecución; en otras plataformas las funciones devuelven valores de fallo"] ,
      "exports": [
        {"kind":"class","name":"Database","members":["constructor()","connect(string path): bool","connectReadOnly(string path): bool","execute(string sql): bool","query(string sql): Cursor","close()","destructor()"]},
        {"kind":"class","name":"Cursor","members":["constructor(ptr s)","next(): bool","getString(int col): string","getInt(int col): int","getFloat(int col): float","close()","destructor()"]}
      ],
      "native_bindings": ["lmr_db_open","lmr_db_open_readonly","lmr_db_is_valid","lmr_db_close","lmr_db_execute","lmr_db_prepare","lmr_db_step","lmr_db_get_text","lmr_db_get_int","lmr_db_get_float","lmr_db_finalize"]
    },
    {
      "id": "Trade",
      "file": "Trade.lmr",
      "summary": "Puente HTTP/WebSocket, acceso a precios compartidos y adaptadores de exchanges.",
      "category": "networking-finance",
      "status": "experimental",
      "platforms": ["windows", "linux", "macos"],
      "dependencies": ["Implementaciones nativas y bibliotecas del puente en src/trade_bridge.c", "Conectividad de red para llamadas a exchanges"],
      "exports": [
        {"kind":"function","name":"setPrice","signature":"setPrice(string symbol, float price)"},
        {"kind":"function","name":"getPrice","signature":"getPrice(string symbol): float"},
        {"kind":"class","name":"Ticker","members":["constructor(string s, float p)","imprimir()"]},
        {"kind":"class","name":"Exchange","members":["constructor(string n)"]},
        {"kind":"class","name":"Binance","members":["constructor()","fetchPrice(string symbol): float","fetchTicker(string symbol): Ticker"]},
        {"kind":"class","name":"Bybit","members":["constructor()","fetchPrice(string symbol): float"]},
        {"kind":"class","name":"Coinbase","members":["constructor()","fetchPrice(string symbol): float"]},
        {"kind":"class","name":"CryptoStream","members":["conectar(string wss_url)","leerMensaje(): string","desconectar()"]}
      ],
      "native_bindings": ["lmr_http_get","lmr_ws_connect","lmr_ws_read","lmr_ws_close","lmr_json_get_number","lmr_set_crypto_price","lmr_get_crypto_price"]
    },
    {
      "id": "Setka",
      "file": "Setka.lmr",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LMR module package manifest",
  "description": "Metadata contract for sharing a versioned LMR module package.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package", "files", "dependencies", "exports", "native_bindings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "summary", "license", "minimum_lmr_version", "platforms"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "version": {"$ref": "#/$defs/version"},
        "summary": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "minimum_lmr_version": {"$ref": "#/$defs/version"},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["all", "windows", "linux", "macos"]}
        },
        "repository": {"type": "string", "format": "uri"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\.lmr$"}
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "version": {"$ref": "#/$defs/version"}
        }
      }
    },
    "exports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "signature"],
        "properties": {
          "kind": {"enum": ["function", "class", "record", "enum"]},
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "signature": {"type": "string", "minLength": 1}
        }
      }
    },
    "native_bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"}
  }
}
